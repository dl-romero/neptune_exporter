[Unit]
Description=Neptune Exporter
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=<USERNAME>
WorkingDirectory=/etc/neptune_exporter
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/env python3 /etc/neptune_exporter/neptune_exporter.py
SyslogIdentifier=neptune_exporter
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
